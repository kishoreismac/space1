{
  "name": "space-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm --workspace @space/backend run dev",
    "dev:frontend": "npm --workspace @space/frontend run dev",
    "db:migrate": "npm --workspace @space/backend run db:migrate",
    "db:reset": "npm --workspace @space/backend run db:reset",
    "seed": "npm --workspace @space/backend run seed",
    "seed:demo": "npm --workspace @space/backend run seed:demo"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4",
    "prettier": "^3.3.3",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
