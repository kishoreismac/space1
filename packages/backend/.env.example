# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Database ---
# SQLite for local dev; switch the provider in schema.prisma to "postgresql"
# and set DATABASE_URL=postgresql://... for production.
DATABASE_URL="file:./dev.db"

# --- Auth ---
JWT_SECRET=replace-me-with-a-strong-secret
JWT_REFRESH_SECRET=replace-me-with-a-different-strong-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Bootstrap admin (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123
